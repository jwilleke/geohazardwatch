{
  "name": "@jwilleke/geohazardwatch-addon",
  "version": "1.2.209",
  "description": "Volcano & geology data platform add-on for ngdpbase — GVP structured records, search, infoboxes, maps",
  "type": "module",
  "main": "index.js",
  "ngdpbase": {
    "slug": "geohazardwatch",
    "type": "domain",
    "domainDefaults": {
      "ngdpbase.chrome.left-menu-page": "left-menu-content",
      "ngdpbase.chrome.footer-page": "footer-content"
    }
  },
  "peerDependencies": {
    "express": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "files": [
    "config",
    "import",
    "lib",
    "managers",
    "pages",
    "plugins",
    "public",
    "routes",
    "views",
    "index.js",
    "index.ts",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwilleke/geohazardwatch.git",
    "directory": "addons/geohazardwatch"
  },
  "author": "jwilleke",
  "license": "MIT"
}
