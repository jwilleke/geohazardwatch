{
  "name": "@jwilleke/geohazardwatch-addon",
  "version": "1.2.291",
  "description": "Volcano & geology data platform add-on for ngdpbase — GVP structured records, search, infoboxes, maps",
  "type": "module",
  "main": "index.js",
  "ngdpbase": {
    "slug": "geohazardwatch",
    "minVersion": "5.26.0",
    "type": "domain",
    "domainDefaults": {
      "ngdpbase.chrome.left-menu-page": "left-menu-content",
      "ngdpbase.chrome.footer-page": "footer-content"
    }
  },
  "files": [
    "index.js",
    "import/*.js",
    "lib/*.js",
    "managers/*.js",
    "plugins/*.js",
    "routes/*.js",
    "!**/*.test.js",
    "config",
    "pages",
    "public",
    "views",
    "README.md"
  ],
  "scripts": {
    "build": "bash ../../scripts/link-core-types.sh && tsc -p tsconfig.json",
    "typecheck": "bash ../../scripts/link-core-types.sh && tsc --noEmit -p tsconfig.json",
    "test": "tsx --test managers/*.test.ts lib/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwilleke/geohazardwatch.git",
    "directory": "addons/geohazardwatch"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "author": "jwilleke",
  "license": "MIT"
}
